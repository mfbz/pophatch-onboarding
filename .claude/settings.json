{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run format)",
      "Bash(npm run build)",
      "Bash(npm run reference:unpack)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)"
    ],
    "deny": [
      "Bash(git * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git * core.hooksPath*)",
      "Bash(git * core.hookspath*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)",
      "Edit(./.githooks/**)",
      "Read(./.secrets/**)",
      "Edit(./.secrets/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.local)"
    ]
  }
}
